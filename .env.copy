# django specific settings
# Must be at least 32 characters (JWT HS256)
SECRET_KEY='insecure-dev-only-key-change-me-in-production-0123456789'
DEBUG=True

# JWT token lifetimes in minutes (defaults: 15 min and 7 days)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_MINUTES=10080


# cors settings (origins allowed to call the API from a browser)
CORS_ALLOWED_ORIGINS='http://localhost:3000'

# db settings
DB_NAME='postgres'
DB_USER='postgres'
DB_PASSWORD='postgres'

# redis/celery settings
REDIS_PORT='6379'
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"
FLOWER_PORT='5555'
