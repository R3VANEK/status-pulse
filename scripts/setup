#!/usr/bin/env bash

if [ ! -f .env ]
then
    echo "Creating .env file from .env.copy..."
    cp ./.env.copy ./.env
fi



if [ ! -d venv ]
then
    echo "Creating virtual environment..."
    python3 -m venv venv
fi

source venv/bin/activate

pip install -r build/requirements.dev.txt

pre-commit install
