#!/usr/bin/env bash

set -e

if command -v python3 &>/dev/null; then
    PYTHON=python3
else
    PYTHON=python
fi

if [ ! -f .env ]
then
    echo "Creating .env file from .env.copy..."
    cp ./.env.copy ./.env
fi



if [ ! -d venv ]
then
    echo "Creating virtual environment..."
    $PYTHON -m venv venv
fi

source venv/bin/activate

pip install --upgrade pip-tools

pip-compile build/backend/requirements.in -o build/backend/requirements.txt
pip-compile build/backend/requirements-dev.in -o build/backend/requirements-dev.txt

pip install -r build/backend/requirements-dev.txt

pre-commit install
